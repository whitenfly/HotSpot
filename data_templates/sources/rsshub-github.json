{
  "id": "rsshub-github",
  "name": "GitHub Trending",
  "type": "rsshub",
  "domain": "开源",
  "enabled": false,
  "limit": 30,
  "minIntervalMinutes": 30,
  "timeoutSeconds": 25,
  "config": {
    "path": "/github/trending/daily/any"
